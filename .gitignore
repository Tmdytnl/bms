# ============================================================
# BMS V1 project .gitignore
# Based on the real repository file tree (Phase 3 validated baseline).
# Decisions documented in deliverables/review/BMS_V1_Git_基线提交说明.md
# ============================================================

# --- General editor / OS / temp files ---
*.tmp
*.bak
*.orig
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Generated Keil and simulator output ---
# The distributable APP package tracks project inputs, not machine-local output.
APP/keil/Build/
APP/keil/Listings/
APP/keil/Objects/
APP/keil/.vscode/
APP/apl/.bms_soc_untracked_placeholder
tests/Build/
*.o
*.obj
*.crf
*.axf
*.bin
*.d
*.dep
*.lnp
*.lst
*.htm
*.build_log.htm

# --- Keil per-user GUI state (file name embeds the Windows user) ---
*.uvguix.*

# --- Temporary working area (PDF page snapshots, downloaded installers) ---
tmp/

# --- Project-memory runtime lock ---
.project-memory/*.lock
